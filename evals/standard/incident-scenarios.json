{
  "schema_version": "1.0",
  "scenarios": [
    {"id":"compute-cpu-001","category":"compute","description":"Request-serving compute is CPU saturated while dependencies are healthy.","signals":[{"component":"compute","signal":"cpu_utilization","value":97,"unit":"percent"},{"component":"datastore","signal":"latency","value":"normal"}],"expected":{"primary_hypothesis":"compute_cpu_saturation","required_checks":["compute_cpu","request_rate","recent_changes"],"must_not_recommend":["scale_datastore"]}},
    {"id":"compute-memory-001","category":"compute","description":"Memory pressure and restarts rise while CPU is normal.","signals":[{"component":"compute","signal":"memory_utilization","value":96,"unit":"percent"},{"component":"compute","signal":"restart_rate","value":"high"}],"expected":{"primary_hypothesis":"compute_memory_pressure","required_checks":["memory_usage","restart_reason","recent_changes"],"must_not_recommend":["scale_datastore"]}},
    {"id":"dependency-latency-001","category":"dependency","description":"A critical dependency is saturated while request-serving compute is healthy.","signals":[{"component":"compute","signal":"utilization","value":38,"unit":"percent"},{"component":"datastore","signal":"connection_utilization","value":96,"unit":"percent"},{"component":"datastore","signal":"latency","value":880,"unit":"ms"}],"expected":{"primary_hypothesis":"dependency_saturation","required_checks":["dependency_utilization","dependency_latency","recent_changes"],"must_not_recommend":["scale_compute"]}},
    {"id":"datastore-connections-001","category":"datastore","description":"Datastore connections approach capacity and operation latency rises.","signals":[{"component":"datastore","signal":"connection_utilization","value":99,"unit":"percent"},{"component":"datastore","signal":"operation_latency","value":"high"}],"expected":{"primary_hypothesis":"datastore_connection_saturation","required_checks":["connection_pool","active_connections","slow_operations"],"must_not_recommend":["increase_request_concurrency"]}},
    {"id":"datastore-locks-001","category":"datastore","description":"Latency rises with lock waits but resource utilization is moderate.","signals":[{"component":"datastore","signal":"lock_waits","value":"high"},{"component":"datastore","signal":"cpu_utilization","value":48,"unit":"percent"}],"expected":{"primary_hypothesis":"datastore_lock_contention","required_checks":["lock_waits","long_transactions","recent_schema_or_query_changes"],"must_not_recommend":["scale_compute"]}},
    {"id":"datastore-storage-001","category":"storage","description":"Datastore free storage is critically low.","signals":[{"component":"datastore","signal":"free_storage","value":3,"unit":"percent"},{"component":"datastore","signal":"write_errors","value":"increasing"}],"expected":{"primary_hypothesis":"storage_capacity_pressure","required_checks":["free_storage","growth_rate","retention_or_cleanup"],"must_not_recommend":["restart_service"]}},
    {"id":"datastore-replication-001","category":"datastore","description":"Read path is stale because replica lag rises.","signals":[{"component":"datastore_replica","signal":"replication_lag","value":"high"},{"component":"primary_datastore","signal":"health","value":"normal"}],"expected":{"primary_hypothesis":"replication_lag","required_checks":["replication_lag","write_rate","replica_health"],"must_not_recommend":["scale_frontend"]}},
    {"id":"messaging-consumer-001","category":"messaging","description":"Queue backlog grows while producers are healthy.","signals":[{"component":"messaging","signal":"backlog","value":"growing"},{"component":"producer","signal":"error_rate","value":"normal"}],"expected":{"primary_hypothesis":"consumer_capacity_or_failure","required_checks":["consumer_health","processing_rate","backlog_age"],"must_not_recommend":["scale_producer"]}},
    {"id":"messaging-producer-001","category":"messaging","description":"Publish failures rise with normal consumer backlog.","signals":[{"component":"producer","signal":"publish_errors","value":"high"},{"component":"messaging","signal":"backlog","value":"normal"}],"expected":{"primary_hypothesis":"producer_or_publish_path_failure","required_checks":["publish_errors","network_path","authorization"],"must_not_recommend":["scale_consumer"]}},
    {"id":"cache-capacity-001","category":"cache","description":"Cache memory is saturated and evictions rise.","signals":[{"component":"cache","signal":"memory_utilization","value":98,"unit":"percent"},{"component":"cache","signal":"evictions","value":"high"}],"expected":{"primary_hypothesis":"cache_capacity_pressure","required_checks":["memory_utilization","evictions","key_growth"],"must_not_recommend":["scale_datastore_without_evidence"]}},
    {"id":"cache-hitratio-001","category":"cache","description":"Cache hit ratio collapses after a configuration change.","signals":[{"component":"cache","signal":"hit_ratio","value":22,"unit":"percent"},{"component":"configuration","signal":"recent_change","value":true}],"expected":{"primary_hypothesis":"cache_behavior_regression","required_checks":["cache_hit_ratio","recent_changes","key_pattern"],"must_not_recommend":["increase_request_timeout"]}},
    {"id":"dns-001","category":"network","description":"Name resolution errors rise while endpoints remain healthy.","signals":[{"component":"dns","signal":"resolution_errors","value":"high"},{"component":"endpoint","signal":"health","value":"normal"}],"expected":{"primary_hypothesis":"dns_resolution_failure","required_checks":["dns_errors","resolver_health","record_changes"],"must_not_recommend":["scale_compute"]}},
    {"id":"tls-001","category":"network","description":"TLS handshakes fail near certificate expiry.","signals":[{"component":"ingress","signal":"tls_handshake_errors","value":"high"},{"component":"certificate","signal":"validity","value":"expired"}],"expected":{"primary_hypothesis":"certificate_or_tls_failure","required_checks":["certificate_validity","certificate_chain","recent_tls_changes"],"must_not_recommend":["scale_compute"]}},
    {"id":"ingress-errors-001","category":"network","description":"Ingress returns errors while backend health is normal.","signals":[{"component":"ingress","signal":"error_rate","value":"high"},{"component":"backend","signal":"health","value":"normal"}],"expected":{"primary_hypothesis":"ingress_or_routing_failure","required_checks":["routing_rules","ingress_logs","recent_changes"],"must_not_recommend":["scale_datastore"]}},
    {"id":"packet-loss-001","category":"network","description":"Cross-component network packet loss correlates with timeouts.","signals":[{"component":"network","signal":"packet_loss","value":12,"unit":"percent"},{"component":"service","signal":"timeouts","value":"high"}],"expected":{"primary_hypothesis":"network_path_degradation","required_checks":["packet_loss","affected_paths","network_changes"],"must_not_recommend":["increase_thread_pool"]}},
    {"id":"external-dependency-001","category":"external_dependency","description":"External dependency latency and errors rise while internal layers are healthy.","signals":[{"component":"external_dependency","signal":"latency","value":"high"},{"component":"internal_compute","signal":"health","value":"normal"}],"expected":{"primary_hypothesis":"external_dependency_degradation","required_checks":["dependency_status","dependency_latency","timeout_and_retry_behavior"],"must_not_recommend":["scale_internal_compute"]}},
    {"id":"bad-release-001","category":"deployment","description":"Errors begin immediately after a release with no infrastructure saturation.","signals":[{"component":"deployment","signal":"recent_release","value":true},{"component":"service","signal":"error_rate","value":"high"},{"component":"infrastructure","signal":"saturation","value":"normal"}],"expected":{"primary_hypothesis":"deployment_regression","required_checks":["release_diff","error_signature","rollback_readiness"],"must_not_recommend":["scale_infrastructure"]}},
    {"id":"config-drift-001","category":"configuration","description":"One environment differs from declared configuration and fails health checks.","signals":[{"component":"configuration","signal":"drift","value":true},{"component":"service","signal":"health_check_failures","value":"high"}],"expected":{"primary_hypothesis":"configuration_drift","required_checks":["declared_vs_runtime_config","change_history","affected_scope"],"must_not_recommend":["increase_capacity"]}},
    {"id":"identity-expiry-001","category":"identity","description":"Authentication failures rise after credential expiry.","signals":[{"component":"identity","signal":"authentication_errors","value":"high"},{"component":"credential","signal":"validity","value":"expired"}],"expected":{"primary_hypothesis":"credential_or_identity_failure","required_checks":["credential_validity","authorization_logs","rotation_history"],"must_not_recommend":["scale_compute"]}},
    {"id":"rate-limit-001","category":"dependency","description":"Requests fail with rate-limit signals while system resources are healthy.","signals":[{"component":"dependency","signal":"rate_limit_events","value":"high"},{"component":"compute","signal":"utilization","value":"normal"}],"expected":{"primary_hypothesis":"rate_limit_exhaustion","required_checks":["rate_limit_events","request_rate","retry_behavior"],"must_not_recommend":["scale_compute"]}},
    {"id":"disk-001","category":"storage","description":"Local writable storage is full and writes fail.","signals":[{"component":"storage","signal":"usage","value":100,"unit":"percent"},{"component":"service","signal":"write_errors","value":"high"}],"expected":{"primary_hypothesis":"disk_space_exhaustion","required_checks":["storage_usage","growth_source","cleanup_or_capacity"],"must_not_recommend":["restart_without_cleanup"]}},
    {"id":"fd-001","category":"compute","description":"Open file descriptors approach the process limit and accepts fail.","signals":[{"component":"process","signal":"file_descriptor_utilization","value":99,"unit":"percent"},{"component":"service","signal":"accept_errors","value":"high"}],"expected":{"primary_hypothesis":"file_descriptor_exhaustion","required_checks":["descriptor_usage","process_limit","connection_leaks"],"must_not_recommend":["scale_datastore"]}},
    {"id":"threadpool-001","category":"compute","description":"Thread pool is exhausted while CPU remains moderate.","signals":[{"component":"service","signal":"thread_pool_utilization","value":100,"unit":"percent"},{"component":"compute","signal":"cpu_utilization","value":45,"unit":"percent"}],"expected":{"primary_hypothesis":"thread_pool_exhaustion","required_checks":["thread_pool_usage","blocked_work","dependency_latency"],"must_not_recommend":["scale_cpu_only"]}},
    {"id":"connection-pool-001","category":"dependency","description":"Application-side dependency connection pool is exhausted.","signals":[{"component":"service","signal":"connection_pool_wait","value":"high"},{"component":"dependency","signal":"health","value":"normal"}],"expected":{"primary_hypothesis":"connection_pool_exhaustion","required_checks":["pool_utilization","pool_wait","connection_lifecycle"],"must_not_recommend":["scale_dependency_without_evidence"]}},
    {"id":"autoscaling-lag-001","category":"compute","description":"Demand spikes faster than new capacity becomes ready.","signals":[{"component":"service","signal":"request_rate","value":"spike"},{"component":"compute","signal":"ready_capacity","value":"lagging"}],"expected":{"primary_hypothesis":"autoscaling_response_lag","required_checks":["scale_trigger","capacity_ready_time","request_rate"],"must_not_recommend":["scale_datastore"]}},
    {"id":"healthcheck-001","category":"configuration","description":"Healthy instances are removed after a health-check configuration change.","signals":[{"component":"health_check","signal":"failures","value":"high"},{"component":"service","signal":"direct_health","value":"normal"},{"component":"configuration","signal":"recent_change","value":true}],"expected":{"primary_hypothesis":"health_check_misconfiguration","required_checks":["health_check_config","direct_health","recent_changes"],"must_not_recommend":["increase_capacity"]}},
    {"id":"failure-domain-001","category":"availability","description":"Only one failure domain shows errors while peers are healthy.","signals":[{"component":"failure_domain_a","signal":"error_rate","value":"high"},{"component":"failure_domain_b","signal":"error_rate","value":"normal"}],"expected":{"primary_hypothesis":"partial_failure_domain_outage","required_checks":["failure_domain_comparison","routing_distribution","provider_or_platform_status"],"must_not_recommend":["global_restart"]}},
    {"id":"load-imbalance-001","category":"network","description":"One backend is overloaded while aggregate utilization is normal.","signals":[{"component":"backend_a","signal":"utilization","value":99,"unit":"percent"},{"component":"backend_b","signal":"utilization","value":25,"unit":"percent"}],"expected":{"primary_hypothesis":"load_distribution_imbalance","required_checks":["request_distribution","routing_state","backend_health"],"must_not_recommend":["scale_all_backends_first"]}},
    {"id":"job-backlog-001","category":"messaging","description":"Background job age and backlog increase while synchronous traffic is normal.","signals":[{"component":"job_queue","signal":"backlog_age","value":"high"},{"component":"synchronous_service","signal":"health","value":"normal"}],"expected":{"primary_hypothesis":"background_processing_degradation","required_checks":["worker_health","processing_rate","backlog_age"],"must_not_recommend":["scale_synchronous_service"]}},
    {"id":"telemetry-gap-001","category":"observability","description":"User reports an issue but required telemetry is missing or stale.","signals":[{"component":"telemetry","signal":"freshness","value":"stale"},{"component":"service","signal":"user_reported_issue","value":true}],"expected":{"primary_hypothesis":"insufficient_evidence","required_checks":["restore_or_collect_evidence","confirm_impact","check_recent_changes"],"must_not_recommend":["production_mutation_without_evidence"]}}
  ]
