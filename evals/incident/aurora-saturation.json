{
  "name": "database-saturation-001",
  "description": "The agent should identify database saturation rather than recommend scaling healthy application tasks.",
  "input": {
    "service": "orders-api",
    "metrics": {
      "ecs_cpu_percent": 35,
      "api_p95_latency_ms": 1800,
      "database": {
        "cpu_percent": 95,
        "connection_utilization_percent": 97,
        "latency_ms": 900,
        "cpu_credit_balance": 0
      },
      "event_stream_lag": "normal"
    }
  },
  "expected": {
    "primary_hypothesis": "database_saturation",
    "required_checks": [
      "database_connections",
      "slow_queries",
      "lock_waits",
      "cpu_credit_balance"
    ],
    "must_not_recommend": [
      "increase_ecs_tasks"
    ]
  }
}
