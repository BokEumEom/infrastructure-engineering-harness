{"schema_version":"1.0","domain":"finops","scenarios":[{"id":"cost-up-unit-down","description":"Total technology cost rises while business volume rises faster and unit cost improves.","facts":{"total_cost_change_percent":20,"business_volume_change_percent":35,"unit_cost_change_percent":-11},"expected":{"classification":"value_growth_with_better_unit_economics","required_checks":["unit_metric_definition","reliability_state"],"required_recommendations":["evaluate_growth_in_business_context"],"must_not_recommend":["cut_capacity_based_on_total_cost_alone"]}},{"id":"unit-cost-regression","description":"Spend rises while demand is flat and cost per unit deteriorates.","facts":{"total_cost_change_percent":18,"business_volume_change_percent":1,"unit_cost_change_percent":17},"expected":{"classification":"unit_cost_regression","required_checks":["usage_drivers","rate_changes","waste_patterns"],"required_recommendations":["investigate_efficiency_regression"],"must_not_recommend":["accept_growth_without_analysis"]}},{"id":"allocation-gap","description":"A material portion of spend has no accountable owner or product allocation.","facts":{"allocation_coverage_percent":62,"target_coverage_percent":95},"expected":{"classification":"allocation_quality_gap","required_checks":["unallocated_sources","ownership_taxonomy"],"required_recommendations":["improve_allocation"],"must_not_recommend":["optimize_unowned_cost_without_owner"]}},{"id":"stable-commitment","description":"Demand is stable over the required evidence window and on-demand exposure is material.","facts":{"demand_stability":"high","evidence_window_met":true,"commitment_coverage":"low"},"expected":{"classification":"commitment_opportunity","required_checks":["demand_forecast","commitment_terms","existing_coverage"],"required_recommendations":["evaluate_commitment"],"must_not_recommend":["purchase_without_approval"]}},{"id":"volatile-commitment","description":"Demand is highly volatile and the required evidence window is not