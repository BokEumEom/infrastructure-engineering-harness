{"schema_version":"1.0","domain":"devops","scenarios":[{"id":"delivery-instability","description":"Deployment frequency is high but change failure rate is rising.","facts":{"deployment_frequency":"high","change_failure_rate":"rising"},"expected":{"classification":"delivery_instability","required_checks":["failure_causes","release_batch_size","quality_gates"],"required_recommendations":["reduce_change_instability"],"must_not_recommend":["increase_deployment_frequency_as_primary_fix"]}},{"id":"rework-high","description":"A large fraction of deployments are unplanned corrective rework.","facts":{"deployment_rework_rate":"high"},"expected":{"classification":"high_delivery_rework","required_checks":["rework_sources","change_failure_patterns"],"required_recommendations":["reduce_rework_sources"],"must_not_recommend":["treat_rework_as_feature_throughput"]}},{"id":"lead-time-bottleneck","description":"Change lead time is long because approvals queue for days.","facts":{"change_lead_time":"long","approval_queue":"dominant"},"expected":{"classification":"flow_bottleneck","required_checks":["value_stream_wait_time","approval_risk_basis"],"required_recommendations":["improve_approval_flow"],"must_not_recommend":["optimize_build_time_first"]}},{"id":"recovery-slow","description":"Failed deployments recover slowly despite frequent releases.","facts":{"failed_deployment_recovery_time":"long","rollback_automation":false},"expected":{"classification":"recovery_capability_gap","required_checks":["rollback_path","detection_time","known_good_release"],"required_recommendations":["improve_recovery_path"],"must_not_recommend":["increase_release_rate_first"]}},{"id":"large-batch","description":"Rare releases contain large multi-feature batches and failures are hard to isolate.","facts":{"deployment_frequency":"low","batch_size":"large","failure_isolation":"poor"},"expected":{"classification":"large_batch_delivery_risk","required_checks":["batch_composition","decoupling_options"],"required_recommendations":["reduce_batch_size"],"must_not_recommend":["add_more_manual_approval_as_only_fix"]}},{"id":"missing-gate","description":"A high-risk schema change has no pre-production compatibility verification.","facts":{"change_risk":"high","compatibility_gate":false},"expected":{"classification":"quality_gate_gap","required_checks":["compatibility","rollback","data_durability"],"required_recommendations":["add_targeted_validation"],"must_not_recommend":["deploy_without_validation"]}},{"id":"rollback-unavailable","description":"A production change cannot be rolled back and no forward-recovery plan exists.","facts":{"rollback_supported":false,"forward_recovery_defined":false},"expected":{"classification":"change_not_recoverable","required_checks":["recovery_strategy","blast_radius"],"required_recommendations":["define_recovery_before_release"],"must_not_recommend":["approve_high_risk_release"]}},{"id":"balanced-delivery","description":"Lead time, deployment frequency, recovery and instability trends are all healthy for the same service.","facts":{"change_lead_time":"improving","deployment_frequency":"steady","failed_deployment_recovery_time":"improving","change_failure_rate":"low","deployment_rework_rate":"low"},"expected":{"classification":"delivery_healthy","required_checks":["trend_consistency"],"required_recommendations":["preserve_current_controls"],"must_not_recommend":["add_process_without_evidence"]}}]}
