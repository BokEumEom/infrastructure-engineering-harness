{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured Incident Knowledge",
  "type": "object",
  "required": ["schema_version", "id", "service", "category", "summary", "symptoms", "root_cause", "lessons"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string"},
    "service": {"type": "string"},
    "category": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "symptoms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "root_cause": {
      "type": "object",
      "required": ["component_type", "failure_mode"],
      "properties": {
        "component_type": {"enum": ["compute", "datastore", "messaging", "cache", "network", "storage", "identity", "external_dependency", "configuration", "deployment", "other"]},
        "failure_mode": {"type": "string"}
      },
      "additionalProperties": true
    },
    "resolution": {"type": "array", "items": {"type": "string"}},
    "lessons": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
