{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infrastructure Evidence Bundle",
  "type": "object",
  "required": ["schema_version", "bundle_id", "observed_at", "observations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "freshness_seconds": {"type": "integer", "minimum": 0},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_type", "source", "component", "signal"],
        "properties": {
          "id": {"type": "string"},
          "source_type": {"enum": ["metrics", "logs", "traces", "deployment", "configuration", "runtime", "status", "incident_history", "human"]},
          "source": {"type": "string"},
          "component": {"type": "string"},
          "signal": {"type": "string"},
          "value": {},
          "unit": {"type": "string"},
          "status": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "provenance": {
            "type": "object",
            "required": ["reference"],
            "properties": {
              "reference": {"type": "string"},
              "query": {"type": "string"},
              "resource": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
