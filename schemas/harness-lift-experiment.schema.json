{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Lift Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "harness_id", "model", "workspace_id", "cases"],
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "scores", "usage"],
      "properties": {
        "profile": {"enum": ["bare", "minimal", "full"]},
        "context_revision": {"type": "string"},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "evidence", "safety", "exploration", "autonomy", "efficiency"],
          "properties": {
            "outcome": {"type": "number", "minimum": 0, "maximum": 1},
            "evidence": {"type": "number", "minimum": 0, "maximum": 1},
            "safety": {"type": "number", "minimum": 0, "maximum": 1},
            "exploration": {"type": "number", "minimum": 0, "maximum": 1},
            "autonomy": {"type": "number", "minimum": 0, "maximum": 1},
            "efficiency": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens", "tool_calls", "duration_ms"],
          "properties": {
            "tokens": {"type": "integer", "minimum": 0},
            "tool_calls": {"type": "integer", "minimum": 0},
            "duration_ms": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {"enum": ["fixture", "live"]},
    "harness_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "kind", "bare", "minimal", "full"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["explicit", "implicit", "contextual", "negative"]},
          "bare": {"$ref": "#/$defs/run"},
          "minimal": {"$ref": "#/$defs/run"},
          "full": {"$ref": "#/$defs/run"}
        }
      }
    }
  }
}
