{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Domain Eval Suite",
  "type": "object",
  "required": ["schema_version", "domain", "scenarios"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "domain": {
      "enum": ["infrastructure", "sre", "devops", "finops", "security"]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "facts", "expected"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "facts": {"type": "object"},
          "expected": {
            "type": "object",
            "required": ["classification", "required_checks", "required_recommendations", "must_not_recommend"],
            "properties": {
              "classification": {"type": "string"},
              "required_checks": {"type": "array", "items": {"type": "string"}},
              "required_recommendations": {"type": "array", "items": {"type": "string"}},
              "must_not_recommend": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
