{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Context Update Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "before_tokens", "after_tokens", "budget_tokens", "human_review_required", "source_of_truth_writeback", "edits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target": {"const": "AGENTS.md"},
    "before_tokens": {"type": "integer", "minimum": 0},
    "after_tokens": {"type": "integer", "minimum": 0},
    "budget_tokens": {"type": "integer", "minimum": 1},
    "human_review_required": {"const": true},
    "source_of_truth_writeback": {"const": false},
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "reason", "evidence_session_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "operation": {"enum": ["add", "modify", "remove", "extract_to_skill"]},
          "target_rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "new_rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "reason": {"type": "string", "minLength": 1},
          "replacement_text": {"type": "string"},
          "skill_target": {"type": "string"},
          "evidence_session_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"operation": {"const": "add"}}, "required": ["operation"]},
            "then": {
              "required": ["new_rule_id", "replacement_text"],
              "properties": {"evidence_session_ids": {"minItems": 2}}
            }
          },
          {
            "if": {"properties": {"operation": {"enum": ["modify", "remove", "extract_to_skill"]}}, "required": ["operation"]},
            "then": {"required": ["target_rule_id"]}
          },
          {
            "if": {"properties": {"operation": {"const": "extract_to_skill"}}, "required": ["operation"]},
            "then": {"required": ["skill_target"]}
          }
        ]
      }
    }
  },
  "allOf": [
    {"properties": {"after_tokens": {"maximum": 5000}}}
  ]
}
