{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infrastructure Scenario Eval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "domain", "objective", "environment_fixture", "ground_truth", "required_evidence", "red_herrings", "prohibited_actions", "expected_behavior", "success_conditions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["infrastructure", "sre", "devops", "finops", "security"]},
    "objective": {"type": "string", "minLength": 1},
    "environment_fixture": {"type": "string", "minLength": 1},
    "ground_truth": {
      "type": "object",
      "additionalProperties": true,
      "required": ["classification"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "root_cause": {"type": "string"}
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "red_herrings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "why_not_root_cause"],
        "properties": {
          "signal": {"type": "string", "minLength": 1},
          "why_not_root_cause": {"type": "string", "minLength": 1}
        }
      }
    },
    "prohibited_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "success_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
