{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinOps Scope Profile",
  "type": "object",
  "required": ["schema_version", "scope", "owner", "allocation", "unit_metrics", "optimization_constraints"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope": {"type": "string"},
    "owner": {"type": "string"},
    "technology_category": {"type": "string"},
    "allocation": {"type": "object", "required": ["dimensions", "shared_cost_policy"], "properties": {"dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "shared_cost_policy": {"type": "string"}, "target_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100}}, "additionalProperties": true},
    "unit_metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "cost_numerator", "value_denominator"], "properties": {"id": {"type": "string"}, "cost_numerator": {"type": "string"}, "value_denominator": {"type": "string"}, "business_context": {"type": "string"}}, "additionalProperties": true}},
    "commitment_policy": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "approval_required": {"type": "boolean"}, "minimum_demand_evidence_window": {"type": "string"}}, "additionalProperties": true},
    "optimization_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "budget": {"type": "object", "properties": {"owner": {"type": "string"}, "review_cadence": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
