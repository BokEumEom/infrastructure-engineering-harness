{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment Resource Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "discovered_at", "scope", "resources", "edges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "graph_id": {"type": "string", "minLength": 1},
    "discovered_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "environment": {"type": "string", "minLength": 1},
        "account": {"type": "string"},
        "region": {"type": "string"},
        "cluster": {"type": "string"},
        "workspace": {"type": "string"}
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "provider", "name", "provenance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "service": {"type": "string"},
          "environment": {"type": "string"},
          "attributes": {"type": "object", "additionalProperties": true},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "reference", "observed_at"],
            "properties": {
              "adapter": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "observed_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "relationship": {
            "enum": ["depends_on", "runs_on", "exposes", "stores_in", "observed_by", "deployed_by", "owned_by", "connected_to"]
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
